{
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      ".git",
      ".gitignore",
      "firebase.json",
      ".firebaserc",
      "Assets/Layout.jpeg"
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          {"key": "Cache-Control", "value": "no-cache, no-store, must-revalidate"},
          {"key": "Pragma", "value": "no-cache"},
          {"key": "Expires", "value": "0"}
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [{"key": "Cache-Control", "value": "max-age=86400"}]
      },
      {
        "source": "**/*.@(png|jpg|jpeg|webp)",
        "headers": [{"key": "Cache-Control", "value": "max-age=604800"}]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
